{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valp.dev/schema/valp-leader-health-record.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "health_policy_id",
    "leader_principal_id",
    "leader_epoch",
    "attempts",
    "policy_exhausted",
    "recorded_at",
    "record_digest"
  ],
  "properties": {
    "schema_version": {"const": "valp-leader-health-record.v1"},
    "health_policy_id": {"type": "string", "minLength": 1},
    "leader_principal_id": {"type": "string", "minLength": 1},
    "leader_epoch": {"type": "integer", "minimum": 1},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "result", "process_status", "evidence_ref"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "result": {"enum": ["pass", "fail", "blocked"]},
          "process_status": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy_exhausted": {"type": "boolean"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
