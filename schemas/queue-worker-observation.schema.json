{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valp:schema:queue-worker-observation:v2",
  "title": "VALP Queue Worker Terminal Observation",
  "type": "object",
  "required": ["schema_version", "task_id", "queue_id", "enqueue_transaction_id", "worker_id", "run_id", "claim_token", "claim_event_id", "observation_sequence", "status", "acknowledged"],
  "properties": {
    "schema_version": {"const": "valp-queue-worker-observation.v2"},
    "task_id": {"type": "string", "minLength": 1},
    "queue_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "enqueue_transaction_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "worker_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "claim_token": {"type": "string", "minLength": 1},
    "claim_event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation_sequence": {"type": "integer", "minimum": 1},
    "status": {"enum": ["completed", "blocked"]},
    "acknowledged": {"const": true},
    "failure_code": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
      "then": {"required": ["failure_code"]},
      "else": {"not": {"required": ["failure_code"]}}
    }
  ],
  "additionalProperties": false
}
