{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VALP Agent Session Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "adapter",
    "task_id",
    "event_sequence",
    "ts",
    "agent",
    "event",
    "binding_ref",
    "generation",
    "identity_token",
    "ownership",
    "context",
    "launch",
    "runtime_scope",
    "runtime_identity"
  ],
  "properties": {
    "schema_version": {"const": "valp-agent-session-receipt.v1"},
    "adapter": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "event_sequence": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "event": {"enum": ["agent_session_provisioned", "agent_session_reused"]},
    "binding_ref": {"const": "agent-sessions.json"},
    "generation": {"type": "integer", "minimum": 1},
    "identity_token": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ownership": {"$ref": "#/$defs/ownership"},
    "context": {"$ref": "#/$defs/context"},
    "launch": {"$ref": "#/$defs/launch"},
    "focused_at_provisioning": {"type": "boolean"},
    "runtime_scope": {"$ref": "#/$defs/runtimeScope"},
    "runtime_identity": {"$ref": "#/$defs/runtimeIdentity"}
  },
  "allOf": [
    {
      "if": {"properties": {"adapter": {"const": "herdr"}}},
      "then": {
        "required": ["focused_at_provisioning"],
        "properties": {
          "focused_at_provisioning": {"const": false}
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ownership": {
      "type": "object",
      "required": ["scope", "project_identity"],
      "properties": {
        "scope": {"enum": ["project", "task"]},
        "task_id": {"type": "string", "minLength": 1},
        "project_identity": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "task"}}},
          "then": {"required": ["task_id"]}
        }
      ]
    },
    "context": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "launch": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "runtime_ref": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["argv"]},
        {"required": ["runtime_ref"]}
      ],
      "additionalProperties": true
    },
    "runtimeScope": {
      "type": "object",
      "required": ["kind", "ownership"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "ownership": {"enum": ["project", "task"]},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "runtimeIdentity": {
      "type": "object",
      "required": ["token"],
      "minProperties": 2,
      "properties": {
        "token": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    }
  }
}
