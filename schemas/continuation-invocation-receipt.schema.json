{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VALP Continuation Invocation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "suspension_id", "suspension_epoch",
    "wake_id", "continuation_generation", "idempotency_key",
    "payload_digest", "adapter", "provider", "durable_boundary_ref",
    "identity_evidence_ref", "duplicate_suppression_ref", "started_at",
    "consumed_at", "result"
  ],
  "properties": {
    "schema_version": {"const": "valp-continuation-invocation-receipt.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "suspension_id": {"type": "string", "minLength": 1},
    "suspension_epoch": {"type": "integer", "minimum": 1},
    "wake_id": {"type": "string", "minLength": 1},
    "continuation_generation": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "invocation_id", "turn_id"],
      "properties": {"id": {"type": "string", "minLength": 1}, "invocation_id": {"type": "string", "minLength": 1}, "turn_id": {"type": "string", "minLength": 1}}
    },
    "durable_boundary_ref": {"type": "string", "minLength": 1},
    "identity_evidence_ref": {"type": "string", "minLength": 1},
    "duplicate_suppression_ref": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "consumed_at": {"type": "string", "minLength": 1},
    "result": {"const": "consumed"}
  }
}
