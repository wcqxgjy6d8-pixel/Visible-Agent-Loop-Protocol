{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:valp:schema:queue-lifecycle-entry:v1",
  "title": "VALP Queue Lifecycle Entry",
  "type": "object",
  "required": ["schema_version", "task_id", "work_item_id", "attempt_id", "dispatch_id", "dispatch_generation", "queue_id", "enqueue_transaction_id", "ledger_revision", "queue_revision", "expected_revision", "previous_entry_digest", "event", "state", "idempotency_key", "event_id", "entry_digest"],
  "properties": {
    "schema_version": {"const": "valp-queue-lifecycle-entry.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "dispatch_id": {"type": "string", "minLength": 1},
    "dispatch_generation": {"type": "integer", "minimum": 1},
    "queue_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "enqueue_transaction_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ledger_revision": {"type": "integer", "minimum": 1},
    "queue_revision": {"type": "integer", "minimum": 1},
    "expected_revision": {"type": "integer", "minimum": 0},
    "previous_entry_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
    "event": {"enum": ["claimed", "cancellation_requested", "cancelled", "completed", "blocked"]},
    "state": {"enum": ["claimed", "cancellation_requested", "cancelled", "completed", "blocked"]},
    "idempotency_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "entry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "worker_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "claim_token": {"type": "string", "minLength": 1},
    "claim_event_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "acknowledged": {"const": true},
    "observation_sequence": {"type": "integer", "minimum": 1},
    "worker_observation_ref": {"type": "string", "minLength": 1},
    "worker_observation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
