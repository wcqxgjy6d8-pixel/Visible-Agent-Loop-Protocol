{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valp.dev/schema/valp-migration-plan.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "migration_id", "installation_id", "source_protocol_version", "target_protocol_version", "source_root", "target_root", "preserve_original_bytes", "task_file_count", "files", "preconditions", "created_at", "plan_digest"],
  "properties": {
    "schema_version": {"const": "valp-migration-plan.v1"},
    "migration_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "installation_id": {"type": "string", "minLength": 1},
    "source_protocol_version": {"type": "string", "minLength": 1},
    "target_protocol_version": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "minLength": 1},
    "target_root": {"type": "string", "minLength": 1},
    "preserve_original_bytes": {"const": true},
    "task_file_count": {"type": "integer", "minimum": 0},
    "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_ref", "digest", "bytes"], "properties": {"source_ref": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "source_schema_versions": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"type": ["string", "null"]}},
    "target_schema_versions": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"type": ["string", "null"]}},
    "ordered_transforms": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "legacy_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "expected_registry_revision": {"type": "integer", "minimum": 0},
    "expected_leader_epoch": {"type": "integer", "minimum": 0},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "affected_plugins": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "affected_tasks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["task_id", "protocol_version", "status", "revision", "handling"], "properties": {"task_id": {"type": "string", "minLength": 1}, "protocol_version": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 0}, "handling": {"const": "legacy-read-only"}}}},
    "approval_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rollback_strategy": {"type": "string", "minLength": 1},
    "validation_cases": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "created_at": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"source_protocol_version": {"const": "0.3.0-draft"}},
        "required": ["source_protocol_version"]
      },
      "then": {
        "required": [
          "source_schema_versions",
          "target_schema_versions",
          "ordered_transforms",
          "legacy_fields",
          "expected_state_revision",
          "expected_registry_revision",
          "expected_leader_epoch",
          "required_capabilities",
          "affected_plugins",
          "affected_tasks",
          "approval_requirements",
          "rollback_strategy",
          "validation_cases"
        ]
      }
    }
  ]
}
