{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valp.dev/schema/doctor-proof-certificate.v1.json",
  "title": "VALP Doctor Proof Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_id",
    "certificate_digest",
    "issued_at",
    "expires_at",
    "subject",
    "subject_digest",
    "dependency_fingerprint",
    "verifier",
    "binding",
    "claims",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "valp-doctor-proof-certificate.v1"},
    "certificate_id": {"type": "string", "pattern": "^proof-[0-9a-f]{16}$"},
    "certificate_digest": {"$ref": "#/$defs/digest"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "string", "minLength": 1},
    "subject_digest": {"$ref": "#/$defs/digest"},
    "dependency_fingerprint": {"$ref": "#/$defs/digest"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "plan_digest"],
      "properties": {
        "workspace": {"type": "string", "minLength": 1},
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
          "subject": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["valid", "stale", "invalid"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
