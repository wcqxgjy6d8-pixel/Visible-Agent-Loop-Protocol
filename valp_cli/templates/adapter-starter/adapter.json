{
  "schema_version": "valp-adapter-manifest.v1",
  "adapter_id": "{{adapter_name}}",
  "adapter_class": "external_runtime",
  "abi_version": "1.0",
  "capabilities": [
    {"operation": "probe", "status": "supported"},
    {"operation": "submit", "status": "supported"},
    {"operation": "observe", "status": "supported"},
    {"operation": "cancel", "status": "unsupported", "reason": "starter runtime cancellation is not implemented"},
    {"operation": "resume", "status": "supported"},
    {"operation": "prove", "status": "supported"}
  ]
}
