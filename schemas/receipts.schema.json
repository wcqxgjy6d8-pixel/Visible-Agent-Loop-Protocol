{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VALP Dispatch Receipt",
  "oneOf": [
    {"$ref": "#/$defs/legacyReceipt"},
    {"$ref": "#/$defs/deterministicReceipt"},
    {"$ref": "#/$defs/protocolReceiptV3"}
  ],
  "$defs": {
    "event": {
      "enum": [
        "dispatch_written",
        "dispatch_inserted",
        "dispatch_submitted",
        "dispatch_completed",
        "dispatch_blocked",
        "dispatch_superseded",
        "manual_dispatch_written",
        "manual_delivery_attested",
        "manual_result_attested",
        "manual_blocked"
      ]
    },
    "role": {
      "enum": ["coordinator", "implementer", "reviewer", "prototype", "researcher", "other"]
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)(?:\\.{0,2})(?:/|$)).+$"
      }
    },
    "legacyReceipt": {
      "type": "object",
      "required": ["ts", "agent", "event", "dispatch_ref"],
      "properties": {
        "ts": {"type": "string"},
        "agent": {"type": "string"},
        "role": {"$ref": "#/$defs/role"},
        "event": {"$ref": "#/$defs/event"},
        "exit_code": {"type": "integer"},
        "summary": {"type": "string"},
        "dispatch_ref": {"type": "string"},
        "expected_refs": {"$ref": "#/$defs/evidenceRefs"},
        "proof": {"type": "object"},
        "runtime": {"type": "object"}
      },
      "not": {"required": ["schema_version"]}
    },
    "deterministicReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_id",
        "task_id",
        "event_sequence",
        "ts",
        "agent",
        "role",
        "work_item_id",
        "dispatch_id",
        "dispatch_generation",
        "event",
        "dispatch_ref",
        "expected_refs"
      ],
      "properties": {
        "schema_version": {"const": "valp-dispatch-receipt.v2"},
        "receipt_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "event_sequence": {"type": "integer", "minimum": 1},
        "ts": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "role": {"$ref": "#/$defs/role"},
        "work_item_id": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "dispatch_generation": {"type": "integer", "minimum": 1},
        "retry_generation": {"type": "integer", "minimum": 1},
        "suspension_epoch": {"type": "integer", "minimum": 1},
        "event": {"$ref": "#/$defs/event"},
        "exit_code": {"type": "integer"},
        "summary": {"type": "string"},
        "dispatch_ref": {"type": "string", "minLength": 1},
        "expected_refs": {"$ref": "#/$defs/evidenceRefs"},
        "proof": {"type": "object", "minProperties": 1},
        "runtime": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"event": {"const": "dispatch_submitted"}},
            "required": ["event"]
          },
          "then": {"required": ["proof"]}
        },
        {
          "if": {
            "properties": {"event": {"const": "dispatch_superseded"}},
            "required": ["event"]
          },
          "then": {
            "required": ["proof"],
            "properties": {
              "proof": {
                "type": "object",
                "required": [
                  "kind",
                  "superseded_submission_receipt_id",
                  "replacement_submission_receipt_id"
                ],
                "properties": {
                  "kind": {"const": "invalid_session_binding"},
                  "superseded_submission_receipt_id": {"type": "string", "minLength": 1},
                  "replacement_submission_receipt_id": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "enum": [
                  "dispatch_completed",
                  "dispatch_blocked",
                  "manual_result_attested",
                  "manual_blocked"
                ]
              }
            }
          },
          "then": {"required": ["suspension_epoch"]}
        }
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safeRef": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)(?:\\.{0,2})(?:/|$)).+$"
    },
    "proofBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_kind", "proof_ref", "proof_digest", "subject_digest"],
      "properties": {
        "proof_kind": {
          "enum": ["process_bound", "content_bound", "manual_attested", "transport_only"]
        },
        "proof_ref": {"$ref": "#/$defs/safeRef"},
        "proof_digest": {"$ref": "#/$defs/digest"},
        "subject_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "approvalBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "policy_digest"],
          "properties": {
            "status": {"const": "not_required"},
            "policy_digest": {"$ref": "#/$defs/digest"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "policy_digest",
            "approval_id",
            "approval_ref",
            "approval_digest",
            "action_digest"
          ],
          "properties": {
            "status": {"const": "granted"},
            "policy_digest": {"$ref": "#/$defs/digest"},
            "approval_id": {"type": "string", "minLength": 1},
            "approval_ref": {"$ref": "#/$defs/safeRef"},
            "approval_digest": {"$ref": "#/$defs/digest"},
            "action_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "migrationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_id",
        "source_schema_version",
        "source_receipt_digest",
        "reconciliation_evidence_digest"
      ],
      "properties": {
        "migration_id": {"type": "string", "minLength": 1},
        "source_schema_version": {
          "enum": ["legacy", "valp-dispatch-receipt.v2"]
        },
        "source_receipt_digest": {"$ref": "#/$defs/digest"},
        "reconciliation_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "protocolReceiptV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "protocol_version",
        "receipt_id",
        "installation_id",
        "leader_epoch",
        "task_id",
        "agent",
        "role",
        "work_item_id",
        "attempt_id",
        "dispatch_id",
        "dispatch_generation",
        "mode",
        "event_sequence",
        "ledger_revision",
        "event",
        "ts",
        "dispatch_ref",
        "payload_digest",
        "expected_refs",
        "proof_bindings",
        "approval_binding",
        "prior_receipt_digest",
        "receipt_digest"
      ],
      "properties": {
        "schema_version": {"const": "valp-dispatch-receipt.v3"},
        "protocol_version": {"const": "0.3.0-draft"},
        "receipt_id": {"type": "string", "minLength": 1},
        "installation_id": {"type": "string", "minLength": 1},
        "leader_epoch": {"type": "integer", "minimum": 0},
        "task_id": {"type": "string", "minLength": 1},
        "agent": {"type": "string", "minLength": 1},
        "role": {"$ref": "#/$defs/role"},
        "work_item_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "dispatch_id": {"type": "string", "minLength": 1},
        "dispatch_generation": {"type": "integer", "minimum": 1},
        "retry_generation": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["full", "remote", "manual"]},
        "event_sequence": {"type": "integer", "minimum": 1},
        "ledger_revision": {"type": "integer", "minimum": 1},
        "event": {"$ref": "#/$defs/event"},
        "ts": {"type": "string", "minLength": 1},
        "dispatch_ref": {"$ref": "#/$defs/safeRef"},
        "payload_digest": {"$ref": "#/$defs/digest"},
        "expected_refs": {"$ref": "#/$defs/evidenceRefs"},
        "suspension_epoch": {"type": "integer", "minimum": 1},
        "proof_bindings": {
          "description": "For submitted and completed receipts, process-bound and content-bound entries use distinct proof refs and digests. The pure reducer enforces this cross-item semantic invariant.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/proofBinding"}
        },
        "approval_binding": {"$ref": "#/$defs/approvalBinding"},
        "migration_binding": {"$ref": "#/$defs/migrationBinding"},
        "prior_receipt_digest": {"$ref": "#/$defs/digest"},
        "receipt_digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"mode": {"const": "manual"}},
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "event": {
                "enum": [
                  "manual_dispatch_written",
                  "manual_delivery_attested",
                  "manual_result_attested",
                  "manual_blocked"
                ]
              },
              "proof_bindings": {
                "contains": {
                  "type": "object",
                  "properties": {"proof_kind": {"const": "manual_attested"}},
                  "required": ["proof_kind"]
                }
              }
            }
          },
          "else": {
            "properties": {
              "event": {
                "not": {
                  "enum": [
                    "manual_dispatch_written",
                    "manual_delivery_attested",
                    "manual_result_attested",
                    "manual_blocked"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {"enum": ["dispatch_submitted", "dispatch_completed"]}
            },
            "required": ["event"]
          },
          "then": {
            "properties": {
              "proof_bindings": {
                "allOf": [
                  {
                    "contains": {
                      "type": "object",
                      "properties": {"proof_kind": {"const": "process_bound"}},
                      "required": ["proof_kind"]
                    }
                  },
                  {
                    "contains": {
                      "type": "object",
                      "properties": {"proof_kind": {"const": "content_bound"}},
                      "required": ["proof_kind"]
                    }
                  },
                  {
                    "not": {
                      "contains": {
                        "type": "object",
                        "properties": {"proof_kind": {"const": "transport_only"}},
                        "required": ["proof_kind"]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "enum": [
                  "dispatch_completed",
                  "dispatch_blocked",
                  "manual_result_attested",
                  "manual_blocked"
                ]
              }
            },
            "required": ["event"]
          },
          "then": {"required": ["suspension_epoch"]},
          "else": {"not": {"required": ["suspension_epoch"]}}
        }
      ]
    }
  }
}
